{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biztrust.local/schemas/session-checkpoint.schema.json",
  "title": "BizTrust platform session checkpoint",
  "description": "AGENTS.md section 6. A checkpoint records exactly one recommended next action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package",
    "state",
    "created_at",
    "objective",
    "completed_scope",
    "branch",
    "baseline_commit",
    "files_changed",
    "validation",
    "decisions",
    "assumptions",
    "blockers",
    "authority_status",
    "next_action_id",
    "next_action",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "work_package": {
      "type": "string",
      "pattern": "^BIZTRUST-WP-[0-9]{3}$"
    },
    "state": {
      "enum": [
        "DRAFT",
        "READY",
        "AUTHORIZED",
        "IN_PROGRESS",
        "VALIDATING",
        "ENGINEERING_READY",
        "ACCEPTED",
        "CLOSED",
        "BLOCKED",
        "WAIT_FOR_AUTHORITY",
        "RECOVERY_REQUIRED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "completed_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_status",
          "observed_at"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_status": {
            "type": "integer"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "output_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_status": {
      "type": "string",
      "minLength": 1
    },
    "next_action_id": {
      "type": "string",
      "pattern": "^NS-[0-9]{3}$"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "recovery": {
      "type": "string",
      "minLength": 1
    },
    "declared_non_coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
