{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biztrust.local/schemas/next-actions.schema.json",
  "title": "BizTrust platform next actions",
  "description": "Ordered, owned and bounded actions. Exactly one is primary, and the state file names it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package",
    "generated_at",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "work_package": {
      "type": "string",
      "pattern": "^BIZTRUST-WP-[0-9]{3}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "primary",
          "title",
          "owner_role",
          "blocked_by",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NS-[0-9]{3}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "primary": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
