{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biztrust.local/schemas/handoff.schema.json",
  "title": "BizTrust platform handoff",
  "description": "AGENTS.md section 7. Silence is never evidence of completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package",
    "created_at",
    "sender_role",
    "receiver_role",
    "source_revision",
    "observed_facts",
    "decisions",
    "completed",
    "remaining",
    "excluded",
    "evidence",
    "risks",
    "first_safe_command",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "work_package": {
      "type": "string",
      "pattern": "^BIZTRUST-WP-[0-9]{3}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sender_role": {
      "type": "string",
      "minLength": 1
    },
    "receiver_role": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observed_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_safe_command": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
